graph = [
    [0, 1, 2, 4, 0],
    [1, 0, 3, 0, 7],
    [2, 3, 0, 5, 8],
    [4, 0, 5, 0, 6],
    [0, 7, 8, 6, 0]
]

n = 5
selected = [False] * n

selected[0] = True

print("Edge : Weight")

for k in range(n - 1):

    minimum = 999
    x = 0
    y = 0

    for i in range(n):

        if selected[i]:

            for j in range(n):

                if not selected[j] and graph[i][j]:

                    if minimum > graph[i][j]:

                        minimum = graph[i][j]
                        x = i
                        y = j

    print(x, "-", y, ":", graph[x][y])

    selected[y] = True
