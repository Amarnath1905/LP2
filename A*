import heapq

graph = {
    'A': [('B', 1), ('C', 3)],
    'B': [('E', 1)],
    'C': [('F', 5)],
    'E': [('F', 2)],
    'F': []
}

h = {
    'A': 6,
    'B': 4,
    'C': 2,
    'E': 1,
    'F': 0
}

def astar(start, goal):

    queue = [(0, start)]
    cost = {start: 0}
    parent = {start: None}

    while queue:

        f, node = heapq.heappop(queue)

        if node == goal:

            path = []

            while node:
                path.append(node)
                node = parent[node]

            return path[::-1]

        for neigh, wt in graph[node]:

            new_cost = cost[node] + wt

            if neigh not in cost or new_cost < cost[neigh]:

                cost[neigh] = new_cost

                priority = new_cost + h[neigh]

                heapq.heappush(queue, (priority, neigh))

                parent[neigh] = node

print(astar('A', 'F'))
